---
import Base from '../layouts/Base.astro';
import Meadow from '../components/Meadow.astro';
import Explainer from '../components/Explainer.astro';
import WagerScene from '../components/WagerScene.astro';
import TreellisScene from '../components/TreellisScene.astro';
import FlatScene from '../components/FlatScene.astro';
import {
  profile,
  hiddenSections,
  news,
  publications,
  publicationsNote,
  research,
  projects,
  education,
  experience,
  awards,
  explainers,
} from '../data/profile';

const wagerEntry = research.find((r) => r.scene === 'wager');
const treellisEntry = research.find((r) => r.scene === 'treellis');
const pelitaEntry = research.find((r) => r.scene === 'pelita');
const lecnoteEntry = research.find((r) => r.scene === 'lecnote');

// Split bio text around glossary terms so they can open their explainer.
const termPattern = new RegExp(`(${Object.keys(explainers).join('|')})`);
const withTerms = (text: string) => text.split(termPattern);

const sections = [
  { id: 'about', label: 'About' },
  { id: 'news', label: 'News' },
  { id: 'research', label: 'Research' },
  { id: 'publications', label: 'Publications' },
  { id: 'projects', label: 'Projects' },
  { id: 'background', label: 'Background' },
  { id: 'contact', label: 'Contact' },
].filter((s) => !hiddenSections.includes(s.id));
const shown = (id: string) => sections.some((s) => s.id === id);
const num = (id: string) => String(sections.findIndex((s) => s.id === id) + 1).padStart(2, '0');
const navItems = sections.filter((s) => ['research', 'publications', 'projects', 'background', 'contact'].includes(s.id));

const listedPapers = publications.filter((p) => !p.hidden);
const pendingVenues = publications.filter((p) => p.hidden && p.status === 'Under review').map((p) => p.venue);
const counts = ['No', 'One', 'Two', 'Three', 'Four', 'Five'];
const pendingLine =
  pendingVenues.length > 0 &&
  `${counts[pendingVenues.length] ?? pendingVenues.length} co-authored paper${pendingVenues.length > 1 ? 's are' : ' is'} out with reviewers right now: at ${new Intl.ListFormat('en', { type: 'conjunction' }).format(pendingVenues)}. Fingers crossed🤞`;
---

<Base title={profile.name} description={`${profile.name} — HCI researcher. ${profile.tagline}`}>
  <Meadow />

  <main class="sheet">
    <header class="top">
      <a class="mark" href="#top" aria-label="Back to top">
        <svg class="leaf" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4.5 19.5C4.5 10.5 10.5 4.5 19.5 4.5C19.5 13.5 13.5 19.5 4.5 19.5Z"></path>
          <path d="M3 21L15.5 8.5M8.5 15.5H12.5M8.5 15.5V11.5M12 12H15.5M12 12V8.5"></path>
        </svg>
        <span class="mark-full" aria-hidden="true">{profile.name}</span>
      </a>
      <nav aria-label="Sections">
        {navItems.map((s) => <a href={`#${s.id}`} data-section={s.id}>{s.label}</a>)}
      </nav>
      <button class="theme" type="button" aria-label="Toggle day and night">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
        </svg>
      </button>
    </header>

    <section class="hero" id="top">
      <div class="intro">
        <figure class="portrait">
          {
            profile.photo ? (
              <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="306" height="408" />
            ) : (
              <div class="portrait-placeholder" aria-hidden="true">
                <svg viewBox="0 0 80 100">
                  <circle cx="40" cy="38" r="17" />
                  <path d="M8 100c2-22 15-34 32-34s30 12 32 34z" />
                </svg>
              </div>
            )
          }
        </figure>
        <div class="greeting">
          <h1>
            <span class="hi">Hi, I’m</span>{' '}{profile.name}<span class="wave" aria-hidden="true">👋</span>
          </h1>
          {profile.nickname && <p class="aka">Some friends also call me {profile.nickname} :)</p>}
        </div>
      </div>

      <dl class="facts">
        <div>
          <dt>Now</dt>
          <dd>MCS, University of Sydney</dd>
        </div>
        <div>
          <dt>Supervisor</dt>
          <dd>Prof. Eduardo Velloso</dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd class="where">
            Sydney
            <time class="clock" data-tz={profile.timezone} aria-label="Local time in Sydney">--:--:--</time>
            <span class="tz"></span>
          </dd>
        </div>
      </dl>
    </section>

    <section class="block" id="about">
      <h2><span>{num('about')}</span>About</h2>
      <div class="body">
        {profile.bio.map((p) => (
          <p>
            {withTerms(p).map((part, i) =>
              i % 2 ? (
                <button class="term" popovertarget={`ex-${explainers[part].id}`} aria-expanded="false">
                  {part}
                  <span class="cmyk" aria-hidden="true"><i /><i /><i /><i /></span>
                </button>
              ) : (
                part
              ),
            )}
          </p>
        ))}
        {Object.values(explainers).map((e) => <Explainer {...e} />)}
        <ul class="chips">
          {profile.interests.map((i) => <li class:list={{ em: profile.highlightInterests.includes(i) }}>{i}</li>)}
        </ul>
      </div>
    </section>

    {shown('news') && <section class="block" id="news">
      <h2><span>{num('news')}</span>News</h2>
      <ul class="body news">
        {
          news.map((n) => (
            <li>
              <span class="date">{n.date}</span>
              <span>{n.text}</span>
            </li>
          ))
        }
      </ul>
    </section>}

    <section class="block" id="research">
      <h2><span>{num('research')}</span>Research</h2>
      <div class="body entries">
        {
          research.map((r) => (
            <article class:list={['entry', { 'has-image': r.image }]}>
              {r.image && (r.scene ? (
                <button class="thumb" type="button" data-scene={r.scene} aria-label={`Open an interactive view of ${r.title}`}>
                  <img src={r.image} alt="" loading="lazy" style={r.focus && `object-position: ${r.focus}`} />
                </button>
              ) : (
                <button class="thumb" type="button" data-full={r.image} data-caption={r.title} aria-label={`Enlarge picture of ${r.title}`}>
                  <img src={r.image} alt="" loading="lazy" style={r.focus && `object-position: ${r.focus}`} />
                </button>
              ))}
              <p class="meta">
                <span class="when">{r.when}</span>
                {r.tags.map((t) => (
                  <span class={`tag tag-${t.kind}`}>
                    {t.kind === 'award' && (
                      <svg class="trophy" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7 4h10v5a5 5 0 0 1-10 0V4Z"></path>
                        <path d="M7 6H5a2 2 0 0 0 0 4h2.4M17 6h2a2 2 0 0 1 0 4h-2.4M12 14v4M8 20h8"></path>
                      </svg>
                    )}
                    {t.label}
                  </span>
                ))}
              </p>
              <h3>{r.title}</h3>
              <p>{r.summary}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="block" id="publications">
      <h2><span>{num('publications')}</span>Publications</h2>
      <div class="body">
        {
          listedPapers.length > 0 ? (
            <ol class="pubs">
              {listedPapers.map((p) => (
                <li>
                  <h3>{p.title}</h3>
                  <p class="authors">
                    {p.authors.map((a, i) => (
                      <>
                        {a === profile.name ? <strong>{a}</strong> : a}
                        {i < p.authors.length - 1 && ', '}
                      </>
                    ))}
                  </p>
                  <p class="meta">
                    <span>{p.venue}</span>
                    <span>{p.status}</span>
                  </p>
                </li>
              ))}
            </ol>
          ) : (
            <p class="note">{publicationsNote}</p>
          )
        }
        {
          pendingLine && (
            <p class="pending">
              <span class="pending-dot" aria-hidden="true"></span>
              <span class="label">Under review</span>
              <span>{pendingLine}</span>
            </p>
          )
        }
      </div>
    </section>

    <section class="block" id="projects">
      <h2><span>{num('projects')}</span>Projects</h2>
      <ul class="body projects">
        {
          projects.map((p) => (
            <li class:list={{ 'has-image': p.image }}>
              {p.image && (
                <button class="thumb" type="button" data-full={p.image} data-caption={p.title} aria-label={`Enlarge picture of ${p.title}`}>
                  <img src={p.image} alt="" loading="lazy" style={p.focus && `object-position: ${p.focus}`} />
                </button>
              )}
              <h3>
                {p.href ? (
                  <a href={p.href} target="_blank" rel="noopener">
                    {p.title} <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  p.title
                )}
              </h3>
              <span class="kind">{p.kind}</span>
              <p>{p.summary}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block" id="background">
      <h2><span>{num('background')}</span>Background</h2>
      <div class="body ledger">
        <h3>Education</h3>
        <ul>
          {education.map((e) => <li><span><b>{e.place}</b> {e.what}</span><span class="date">{e.when}</span></li>)}
        </ul>
        <h3>Experience</h3>
        <ul>
          {experience.map((e) => <li><span><b>{e.place}</b> {e.what}</span><span class="date">{e.when}</span></li>)}
        </ul>
        <h3>Awards</h3>
        <ul>
          {awards.map((a) => <li><span><b>{a.what}</b> {a.where}</span><span class="date">{a.when}</span></li>)}
        </ul>
      </div>
    </section>

    <section class="block" id="contact">
      <h2><span>{num('contact')}</span>Contact</h2>
      <div class="body">
        <p class="hello">Always happy to talk about people, AI, and the things they make together :)</p>
        <ul class="emails">
          {
            profile.emails.map((e) => (
              <li>
                <span class="label">{e.label}</span>
                <a href={`mailto:${e.address}`}>{e.address}</a>
                <button type="button" class="copy" data-copy={e.address}>Copy</button>
              </li>
            ))
          }
        </ul>
        {
          profile.links.length > 0 && (
            <p class="links">
              {profile.links.map((l) => <a href={l.href}>{l.label} ↗</a>)}
            </p>
          )
        }
      </div>
    </section>

    <footer class="foot">
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <span>Grown in Sydney</span>
    </footer>
  </main>

  <!-- Project pictures, full size: click a preview to open, anywhere or Esc to close. -->
  <dialog class="lightbox" aria-label="Picture">
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
  </dialog>
  {wagerEntry && <WagerScene title={wagerEntry.title} />}
  {treellisEntry && <TreellisScene title={treellisEntry.title} />}
  {pelitaEntry && <FlatScene scene="pelita" title={pelitaEntry.title} />}
  {lecnoteEntry && <FlatScene scene="lecnote" title={lecnoteEntry.title} />}
</Base>

<script>
  // Theme toggle: the meadow listens for `themechange` and fades to night.
  const root = document.documentElement;
  document.querySelector('.theme')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    window.dispatchEvent(new Event('themechange'));
  });

  // Local time in Sydney, as a little digital clock: each digit is its own
  // cell so only the ones that change roll over, and the colons blink.
  const clock = document.querySelector<HTMLElement>('.clock');
  if (clock) {
    const tz = clock.dataset.tz;
    const fmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: tz,
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hourCycle: 'h23',
    });
    const zone = new Intl.DateTimeFormat('en-AU', { timeZone: tz, timeZoneName: 'shortOffset' });
    const tzLabel = document.querySelector<HTMLElement>('.tz');

    clock.textContent = '';
    const cells: HTMLSpanElement[] = [];
    'hh:mm:ss'.split('').forEach((ch) => {
      const cell = document.createElement('span');
      cell.className = ch === ':' ? 'colon' : 'digit';
      cell.textContent = ch === ':' ? ':' : '0';
      clock.append(cell);
      cells.push(cell);
    });

    const tick = () => {
      const now = new Date();
      fmt
        .format(now)
        .split('')
        .forEach((ch, i) => {
          const cell = cells[i];
          if (!cell || cell.className.startsWith('colon') || cell.textContent === ch) return;
          cell.textContent = ch;
          cell.classList.remove('roll');
          void cell.offsetWidth; // restart the roll animation
          cell.classList.add('roll');
        });
      clock.setAttribute('datetime', now.toISOString());
      if (tzLabel) tzLabel.textContent = zone.formatToParts(now).find((p) => p.type === 'timeZoneName')?.value ?? '';
    };
    tick();
    // line up with the start of each second
    setTimeout(() => {
      tick();
      setInterval(tick, 1000);
    }, 1000 - (Date.now() % 1000));
  }

  // Copy-to-clipboard for emails.
  document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Press ⌘C';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1600);
    });
  });

  // Gently reveal sections as they come into view.
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }),
    { rootMargin: '0px 0px -8% 0px' },
  );
  document.querySelectorAll('.block').forEach((el) => io.observe(el));

  // Sticky header: frost it once it's pinned, show the full name once the
  // headline is gone, and mark the nav link for the section being read.
  const top = document.querySelector<HTMLElement>('.top');
  const sheet = document.querySelector<HTMLElement>('.sheet');
  const headline = document.querySelector<HTMLElement>('h1');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('nav a[data-section]')];
  const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];
  let queued = false;
  function updateHeader() {
    queued = false;
    if (!top || !sheet || !headline) return;
    top.classList.toggle('stuck', sheet.getBoundingClientRect().top < 0);
    top.classList.toggle('named', headline.getBoundingClientRect().bottom < top.offsetHeight);

    const line = innerHeight * 0.35;
    const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
    let current = '';
    for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s.id;
    if (atBottom) current = sections[sections.length - 1]?.id ?? current;
    for (const a of links) a.setAttribute('aria-current', String(a.dataset.section === current));
  }
  addEventListener(
    'scroll',
    () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(updateHeader);
      }
    },
    { passive: true },
  );
  addEventListener('resize', updateHeader);
  updateHeader();

  // Lightbox for project pictures.
  const lightbox = document.querySelector<HTMLDialogElement>('.lightbox');
  if (lightbox) {
    const img = lightbox.querySelector('img')!;
    const caption = lightbox.querySelector('figcaption')!;
    document.querySelectorAll<HTMLButtonElement>('.thumb[data-full]').forEach((btn) => {
      btn.addEventListener('click', () => {
        img.src = btn.dataset.full ?? '';
        caption.textContent = btn.dataset.caption ?? '';
        lightbox.showModal();
      });
    });
    lightbox.addEventListener('click', () => lightbox.close());
  }
</script>

<style>
  /* The column takes ~58% of the screen, close to a golden-ratio split with the
     meadow. It's a pane of frosted glass: the grass shows through, softly. */
  .sheet {
    position: relative;
    --pad-x: clamp(40px, 5vw, 80px);
    width: clamp(680px, 58vw, 980px);
    margin: 30vh auto 28px; /* open on a full-width view of the forest */
    padding: 8px var(--pad-x) 40px;
    border-radius: 22px;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    backdrop-filter: blur(24px) saturate(1.4);
    border: 1px solid var(--glass-edge);
    box-shadow: var(--shadow);
  }

  /* At night the glass edge catches moonlight from above: brightest along the
     top, fading down the sides, with a faint green halo around the pane. */
  .sheet::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      180deg,
      rgb(205 240 215 / 0.42),
      rgb(205 240 215 / 0.1) 18%,
      rgb(205 240 215 / 0.05) 60%,
      rgb(205 240 215 / 0.12)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.8s ease;
    pointer-events: none;
  }

  :global([data-theme='dark']) .sheet::before {
    opacity: 1;
  }

  :global([data-theme='dark']) .sheet {
    box-shadow:
      var(--shadow),
      0 0 48px -12px rgb(130 200 155 / 0.22);
  }

  /* ---------- Top bar ---------- */
  /* Sticks to the top of the window while scrolling. Once stuck it spans the
     card edge to edge on frosted glass, so text scrolling under it blurs away. */
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 0 calc(var(--pad-x) * -1);
    padding: 20px var(--pad-x) 18px;
    border-radius: 22px 22px 0 0;
    transition:
      background-color 0.4s ease,
      border-radius 0.4s ease;
  }

  .top::after {
    content: '';
    position: absolute;
    left: var(--pad-x);
    right: var(--pad-x);
    bottom: 0;
    height: 1px;
    background: var(--rule);
    transition:
      left 0.4s ease,
      right 0.4s ease;
  }

  .top.stuck {
    border-radius: 0;
    background-color: var(--nav-bg);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }

  .top.stuck::after {
    left: 0;
    right: 0;
  }

  /* A line-drawn leaf; the name slides in beside it once the headline is gone. */
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    font-size: 16px;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
    color: var(--ink);
    margin-right: auto;
  }

  .leaf {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform-origin: 12% 88%;
    transition: transform 0.6s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  .mark:hover .leaf {
    transform: rotate(-12deg);
  }

  .mark-full {
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.35s ease,
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .top.named .mark-full {
    opacity: 1;
    transform: none;
  }

  nav {
    display: flex;
    gap: 22px;
    font-size: 13.5px;
  }

  nav a {
    position: relative;
    color: var(--ink-2);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='true'] {
    color: var(--ink);
  }

  /* a small dot marks the section you're reading */
  nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -9px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateX(-50%) scale(0);
    transition: transform 0.3s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  nav a[aria-current='true']::after {
    transform: translateX(-50%) scale(1);
  }

  .theme {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }

  .theme:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .theme svg {
    grid-area: 1 / 1;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    transition:
      opacity 0.4s,
      transform 0.6s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  .moon {
    opacity: 0;
    transform: rotate(-60deg) scale(0.6);
  }

  :global([data-theme='dark']) .sun {
    opacity: 0;
    transform: rotate(60deg) scale(0.6);
  }

  :global([data-theme='dark']) .moon {
    opacity: 1;
    transform: none;
  }

  /* ---------- Hero ---------- */
  .hero {
    padding: 56px 0 44px;
  }

  /* Small portrait on the left, a greeting beside it (like a CV header). */
  .intro {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 28px;
  }

  .portrait {
    width: 96px;
    aspect-ratio: 3 / 4;
    margin: 0;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--glass-edge);
    box-shadow: 0 8px 22px -10px rgb(10 30 10 / 0.35);
  }

  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait-placeholder {
    display: grid;
    place-items: end center;
    height: 100%;
    background: linear-gradient(160deg, var(--accent-soft), color-mix(in srgb, var(--accent) 35%, var(--paper)));
  }

  .portrait-placeholder svg {
    width: 78%;
    fill: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  h1 {
    margin: 0;
    font-weight: 400;
    font-size: clamp(28px, 3.2vw, 44px);
