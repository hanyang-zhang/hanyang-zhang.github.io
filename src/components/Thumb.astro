---
// Small line drawings for the explainer's side panel, on a 40×40 grid.
// `.a` fills with the facet's ink, `.as` strokes with it, `.soft` tones it down.
interface Props {
  name: string;
}
const { name } = Astro.props;

const halftone = Array.from({ length: 25 }, (_, k) => ({ x: 8 + (k % 5) * 6, y: 8 + Math.floor(k / 5) * 6, r: 0.5 + ((k % 5) + Math.floor(k / 5)) * 0.32 }));
---

<svg class="thumb" viewBox="0 0 40 40" aria-hidden="true">
  {name === 'interaction' && (
    <>
      <rect x="12" y="5" width="16" height="30" rx="3" />
      <path d="M17 8h6M15 13h10M15 16h7" />
      <rect class="a" x="15" y="20" width="10" height="5" rx="1.5" />
      <circle class="as" cx="25" cy="27" r="4" />
    </>
  )}
  {name === 'vr' && (
    <>
      <path d="M6 16a3 3 0 0 1 3-3h22a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-6l-3-3h-4l-3 3H9a3 3 0 0 1-3-3z" />
      <circle class="a" cx="14" cy="20" r="3" />
      <circle class="a" cx="26" cy="20" r="3" />
      <path d="M6 18H3M34 18h3" />
    </>
  )}
  {name === 'graphic' && (
    <>
      <circle class="a" cx="15" cy="15" r="7" />
      <rect x="19" y="19" width="13" height="13" rx="1" />
      <path d="M7 33l6-10 6 10z" />
    </>
  )}
  {name === 'publishing' && (
    <>
      <rect x="6" y="7" width="18" height="25" rx="1.5" />
      <path d="M9 11h12M9 14h12M9 17h8" />
      <rect class="a" x="9" y="20" width="12" height="8" rx="1" />
      <rect class="bg" x="24" y="15" width="11" height="19" rx="2.5" />
      <path d="M27 20h5M27 23h5M27 26h3" />
    </>
  )}
  {name === 'code' && (
    <>
      <path d="M13 12l-6 8 6 8M27 12l6 8-6 8" />
      <path class="as" d="M22.5 10l-5 20" />
    </>
  )}
  {name === 'teapot' && (
    <>
      <ellipse cx="20" cy="25" rx="10" ry="7" />
      <path d="M15 18.5c1.5-2.5 8.5-2.5 10 0M10.5 24C7 23 5 20 4 16M30 21c4.5 0 5.5 7 0 8" />
      <circle cx="20" cy="15" r="1.5" />
      <path class="as" d="M10 25h20M11.5 21.5h17M11.5 28.5h17M20 18v14M15 18.5c-2 4-2 9 0 12.5M25 18.5c2 4 2 9 0 12.5" />
    </>
  )}
  {name === 'halftone' && (
    <g class="a">
      {halftone.map((d) => <circle cx={d.x} cy={d.y} r={d.r} />)}
    </g>
  )}
  {name === 'ai' && (
    <>
      <path d="M8 12l12 4M8 12l12 12M8 20l12-4M8 20l12 4M8 28l12-12M8 28l12-4M20 16l12 4M20 24l12-4" />
      <g class="bg">
        <circle cx="8" cy="12" r="2.5" />
        <circle cx="8" cy="20" r="2.5" />
        <circle cx="8" cy="28" r="2.5" />
        <circle cx="20" cy="16" r="2.5" />
        <circle cx="20" cy="24" r="2.5" />
      </g>
      <circle class="a" cx="32" cy="20" r="3" />
    </>
  )}
  {name === 'workflow' && (
    <>
      <rect x="4" y="15" width="8" height="10" rx="1.5" />
      <rect x="16" y="15" width="8" height="10" rx="1.5" />
      <rect class="a" x="28" y="15" width="8" height="10" rx="1.5" />
      <path d="M12 20h4M24 20h4M14 18l2 2-2 2M26 18l2 2-2 2" />
    </>
  )}
  {name === 'pcb' && (
    <>
      <rect x="6" y="8" width="28" height="24" rx="2" />
      <path class="as" d="M10 14h8l4 4h8M10 26h6l4-4M26 26h4" />
      <g class="a">
        <circle cx="10" cy="14" r="1.8" />
        <circle cx="30" cy="18" r="1.8" />
        <circle cx="10" cy="26" r="1.8" />
        <circle cx="20" cy="22" r="1.8" />
        <circle cx="26" cy="26" r="1.8" />
      </g>
    </>
  )}
  {name === 'chip' && (
    <>
      <rect x="11" y="11" width="18" height="18" rx="2" />
      <path d="M15 7v4M20 7v4M25 7v4M15 29v4M20 29v4M25 29v4M7 15h4M7 20h4M7 25h4M29 15h4M29 20h4M29 25h4" />
      <path class="as" d="M15 16h6M15 20h10M15 24h4" />
    </>
  )}
  {name === 'sensor' && (
    <>
      <path class="as" d="M4 24h6l3-8 4 14 4-12 3 6h12" />
      <rect class="a" x="27" y="8" width="8" height="6" rx="1.5" />
      <path d="M31 14v6" />
    </>
  )}
  {name === 'flex' && (
    <g transform="rotate(-10 20 20)">
      <rect x="5" y="11" width="30" height="18" rx="3" />
      <path class="as" d="M9 23h4v-6h4v8h4v-8h4v6h6" />
      <circle class="a" cx="9" cy="23" r="1.6" />
      <circle class="a" cx="31" cy="23" r="1.6" />
    </g>
  )}
  {name === 'cie' && (
    <g class="mix">
      <circle class="ink-c" cx="16.5" cy="16.5" r="9" />
      <circle class="ink-m" cx="23.5" cy="16.5" r="9" />
      <circle class="ink-y" cx="20" cy="22.5" r="9" />
    </g>
  )}
  {name === 'gamut' && (
    <>
      <rect x="3" y="8" width="17" height="13" rx="1.5" />
      <path d="M9 24h5M11.5 21v3" />
      <rect class="a" x="7" y="11.5" width="9" height="6" rx="1" />
      <path d="M25 11h7l3 3v15H25z" />
      <rect class="a" x="27.5" y="17" width="5" height="5" rx="0.8" />
      <path class="as" d="M11 28c3 5 11 6 15 3M24.2 29.4l1.8 1.6-1 2.2" />
    </>
  )}
  {name === 'colourbar' && (
    <>
      <rect class="ink-c" x="4" y="10" width="6" height="8" rx="1" />
      <rect class="ink-m" x="11" y="10" width="6" height="8" rx="1" />
      <rect class="ink-y" x="18" y="10" width="6" height="8" rx="1" />
      <rect class="ink-k" x="25" y="10" width="6" height="8" rx="1" />
      <circle class="bg" cx="25" cy="26" r="6" />
      <path d="M29.5 30.5l5 5" />
    </>
  )}
  {name === 'eye' && (
    <>
      <path d="M4 20c5-8 11-11 16-11s11 3 16 11c-5 8-11 11-16 11S9 28 4 20z" />
      <circle class="a" cx="20" cy="20" r="5.5" />
      <circle class="pupil" cx="20" cy="20" r="2" />
    </>
  )}
  {name === 'print3d' && (
    <>
      <path d="M5 8h30M17 8v3h6V8M18.5 11l1.5 3 1.5-3M7 35h26" />
      <path class="as" d="M12 32h16M13 29h14M14 26h12M15.5 23h9" />
    </>
  )}
  {name === 'cad' && (
    <>
      <path d="M8 28V15h10v-5h12v18z" />
      <circle cx="24" cy="21" r="3" />
      <path class="as" d="M8 33h22M8 31v4M30 31v4M35 10v18M33 10h4M33 28h4" />
    </>
  )}
  {name === 'press' && (
    <>
      <circle class="a" cx="14" cy="13" r="6" />
      <circle cx="14" cy="27" r="6" />
      <path d="M4 20h32M32 17l3 3-3 3" />
    </>
  )}
  {name === 'dieline' && (
    <>
      <rect class="a soft" x="15" y="13" width="10" height="10" />
      <path d="M15 5h10v8h8v10h-8v12H15V23H7V13h8z" />
      <path class="dash" d="M15 13h10M15 23h10M15 13v10M25 13v10" />
    </>
  )}
  {name === 'ink' && (
    <>
      <path class="a" d="M20 6c-4 6-8 10.5-8 15a8 8 0 0 0 16 0c0-4.5-4-9-8-15z" />
      <path d="M7 35h26" />
    </>
  )}
  {name === 'paper' && (
    <>
      <path d="M9 6h16l6 6v22H9zM25 6v6h6" />
      <path class="as" d="M12 18c3-2 5 2 8 0s5 2 8 0M12 23c3-2 5 2 8 0s5 2 8 0M12 28c3-2 5 2 7 0" />
    </>
  )}
  {name === 'spread' && (
    <>
      <path d="M20 8c-2 3-3.5 5-3.5 7a3.5 3.5 0 0 0 7 0c0-2-1.5-4-3.5-7z" />
      <path d="M5 28h30" />
      <ellipse class="as dash" cx="20" cy="27" rx="10" ry="4" />
      <ellipse class="a" cx="20" cy="27" rx="5" ry="2.2" />
    </>
  )}
</svg>

<style>
  .thumb {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .a {
    fill: var(--ink-f);
    stroke: none;
  }

  .as {
    stroke: var(--ink-f);
  }

  .soft {
    opacity: 0.35;
  }

  .bg {
    fill: var(--paper);
  }

  .dash {
    stroke-dasharray: 2 2;
  }

  .pupil {
    fill: var(--ink);
    stroke: none;
  }

  /* Overprinted inks: cyan, magenta and yellow darken to black where they
     overlap, even at night (isolated so they don't multiply into the tile). */
  .mix {
    isolation: isolate;
  }

  .mix circle {
    mix-blend-mode: multiply;
  }

  .ink-c { fill: var(--c); stroke: none; }
  .ink-m { fill: var(--m); stroke: none; }
  .ink-y { fill: var(--y); stroke: none; }
  .ink-k { fill: var(--ink); stroke: none; }
</style>
