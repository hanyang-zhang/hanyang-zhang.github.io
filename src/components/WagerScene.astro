---
// The AI wager research picture, opened large: a 3D scene of a drawing pulled into its
// layers on the left, the stages of a wager on the right. Choosing a stage moves the
// scene; on open it plays through once and rests on the evidence. The forest is held
// still while it's open, and the scene is only loaded on first open.
import { wagerStages } from '../data/profile';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<dialog class="scene-box" aria-label={title}>
  <figure>
    <div class="panel">
      <div class="stage">
        <canvas></canvas>
        <span class="hint">Drag to turn</span>
      </div>
      <aside>
        <p class="eyebrow">How a dispute unfolds</p>
        <ol class="stages">
          {
            wagerStages.map((s, i) => (
              <li>
                <button type="button">
                  <span class="icon">
                    {i === 0 && (
                      <svg viewBox="0 0 40 40" aria-hidden="true">
                        <path d="M8 8h24a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H18l-6 5v-5H8a5 5 0 0 1-5-5V13a5 5 0 0 1 5-5z" fill="#ffffff" />
                        <text x="20" y="22.5" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" font-weight="700" fill="#e0484f">AI?</text>
                      </svg>
                    )}
                    {i === 1 && (
                      <svg viewBox="0 0 40 40" aria-hidden="true">
                        <circle cx="15" cy="21" r="10" fill="#e9b949" />
                        <circle cx="15" cy="21" r="6.5" fill="#f5d27a" />
                        <circle cx="25" cy="19" r="10" fill="#f0c35c" />
                        <circle cx="25" cy="19" r="6.5" fill="#f8dc8f" />
                        <text x="25" y="22.6" text-anchor="middle" font-family="Inter, sans-serif" font-size="9.5" font-weight="700" fill="#a8761c">¥</text>
                      </svg>
                    )}
                    {i === 2 && (
                      <svg viewBox="0 0 40 40" aria-hidden="true">
                        <rect x="9" y="5" width="22" height="30" rx="5" fill="#ffffff" />
                        <g fill="#52c7bf"><circle cx="14.5" cy="13" r="2.4" /><circle cx="14.5" cy="20" r="2.4" /><circle cx="14.5" cy="27" r="2.4" /></g>
                        <path d="M19.5 13h7M19.5 20h7M19.5 27h5" stroke="#c3cbbb" stroke-width="2.4" stroke-linecap="round" />
                      </svg>
                    )}
                    {i === 3 && (
                      <svg viewBox="0 0 40 40" aria-hidden="true">
                        <rect x="4" y="7" width="32" height="22" rx="5" fill="#2b2f34" />
                        <path d="M11 22c3-6 6 2 9-3s5 1 9-4" stroke="#52c7bf" stroke-width="2.6" stroke-linecap="round" fill="none" />
                        <circle cx="10" cy="12.5" r="2.4" fill="#e0484f" />
                        <rect x="15" y="31" width="10" height="3.5" rx="1.75" fill="#2b2f34" />
                      </svg>
                    )}
                    {i === 4 && (
                      <svg viewBox="0 0 40 40" aria-hidden="true">
                        <rect x="9" y="12" width="9" height="21" rx="4.5" fill="#52c7bf" />
                        <rect x="22" y="18" width="9" height="15" rx="4.5" fill="#c3cbbb" />
                        <rect x="6" y="33" width="28" height="3" rx="1.5" fill="#d9ded2" />
                      </svg>
                    )}
                    {i === 5 && (
                      <svg viewBox="0 0 40 40" aria-hidden="true">
                        <circle cx="12" cy="24" r="7.5" fill="#f0c35c" />
                        <circle cx="12" cy="24" r="4.5" fill="#f8dc8f" />
                        <path d="M14 13c4-5 11-5 14 0M25 9.5l3.5 3.5-4.6 1.4" stroke="#c3cbbb" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                        <circle cx="28" cy="24" r="7.5" fill="#52c7bf" />
                        <path d="M24.5 24l2.3 2.3 4.2-4.6" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                      </svg>
                    )}
                  </span>
                  <span class="words">
                    <span class="name"><span class="n">{String(i + 1).padStart(2, '0')}</span>{s.title}</span>
                    <span class="text">{s.text}</span>
                    <span class="bar"></span>
                  </span>
                </button>
              </li>
            ))
          }
        </ol>
      </aside>
      <button class="close" type="button" aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <figcaption>
      {title}
      <small>Hatsune Miku © Crypton Future Media, INC. · piapro.net</small>
    </figcaption>
  </figure>
</dialog>

<script>
  import type { WagerScene } from '../scripts/wager/scene';

  const box = document.querySelector<HTMLDialogElement>('.scene-box');
  if (box) {
    const stage = box.querySelector<HTMLElement>('.stage')!;
    const panel = box.querySelector<HTMLElement>('.panel')!;
    const buttons = [...box.querySelectorAll<HTMLButtonElement>('.stages button')];
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DWELL = 3600;
    box.style.setProperty('--dwell', `${DWELL}ms`);

    let scene: WagerScene | null = null;
    let timer = 0;
    let opening = 0; // bumps on every open and close, so a slow load can tell it's stale
    let current = 1;
    let touched = false; // a stage was chosen, so the tour shouldn't start

    const backdrop = () => getComputedStyle(panel).backgroundColor;
    const narrow = matchMedia('(max-width: 760px)');
    const show = (n: number) => {
      current = n;
      scene?.setStep(n);
      buttons.forEach((b, i) => {
        b.parentElement!.classList.toggle('on', i + 1 === n);
        b.setAttribute('aria-current', i + 1 === n ? 'step' : 'false');
      });
      // On a phone the stages are a row; keep the current one in view.
      const li = buttons[n - 1].parentElement!;
      if (narrow.matches) li.parentElement!.scrollTo({ left: li.offsetLeft - 16, behavior: calm ? 'auto' : 'smooth' });
    };
    const stop = () => {
      clearTimeout(timer);
      box.classList.remove('playing');
    };
    // Play 1 → 6 once, then rest on the evidence.
    const tour = () => {
      let n = 1;
      box.classList.add('playing');
      const next = () => {
        n += 1;
        if (n > 6) {
          stop();
          show(4);
          return;
        }
        show(n);
        timer = window.setTimeout(next, DWELL);
      };
      timer = window.setTimeout(next, DWELL);
    };

    async function open() {
      const ticket = ++opening;
      touched = false;
      show(calm ? 4 : 1);
      box!.showModal();
      window.dispatchEvent(new Event('meadowpause'));
      // Each opening draws on its own canvas, so a load that's abandoned can't share a
      // WebGL context with the one that replaced it.
      const canvas = document.createElement('canvas');
      stage.querySelector('canvas')!.replaceWith(canvas);
      const { mountWager } = await import('../scripts/wager/scene');
      if (ticket !== opening) return;
      const made = await mountWager(canvas, { background: backdrop(), step: current, still: calm });
      if (ticket !== opening) return made.dispose();
      scene = made;
      if (!calm && !touched) tour();
    }

    document.querySelectorAll<HTMLButtonElement>('.thumb[data-scene="wager"]').forEach((b) => b.addEventListener('click', open));
    buttons.forEach((b, i) => {
      b.addEventListener('click', () => {
        touched = true;
        stop();
        show(i + 1);
      });
      b.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        buttons[Math.min(5, Math.max(0, i + (e.key === 'ArrowDown' ? 1 : -1)))].focus();
      });
    });
    box.querySelector('.close')!.addEventListener('click', () => box.close());
    box.addEventListener('click', (e) => {
      if (!panel.contains(e.target as Node)) box.close();
    });
    box.addEventListener('close', () => {
      opening++;
      stop();
      scene?.dispose();
      scene = null;
      window.dispatchEvent(new Event('meadowresume'));
    });
    window.addEventListener('themechange', () => scene?.setBackground(backdrop()));
  }
</script>

<style>
  .scene-box {
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100dvh;
    margin: 0;
    padding: 24px;
    border: 0;
    background: transparent;
    opacity: 0;
    transition:
      opacity 0.25s ease,
      overlay 0.25s allow-discrete,
      display 0.25s allow-discrete;
  }

  .scene-box[open] {
    display: grid;
    place-items: center;
    opacity: 1;
  }

  @starting-style {
    .scene-box[open] {
      opacity: 0;
    }
  }

  .scene-box::backdrop {
    background: rgb(8 20 12 / 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  figure {
    display: grid;
    justify-items: center;
    gap: 12px;
    margin: 0;
  }

  figcaption {
    display: grid;
    justify-items: center;
    gap: 4px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    color: rgb(255 255 255 / 0.75);
  }

  /* fan art of a character used under Crypton's licence for non-commercial work */
  figcaption small {
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: none;
    color: rgb(255 255 255 / 0.5);
  }

  .panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    width: min(1100px, calc(100vw - 48px));
    height: min(640px, calc(100dvh - 90px));
    border-radius: 14px;
    overflow: hidden;
    background: var(--paper);
    box-shadow: 0 20px 60px -10px rgb(0 0 0 / 0.5);
  }

  .stage {
    position: relative;
    min-height: 0;
  }

  /* the canvas is swapped for a fresh one on every open, so it carries no scoped attribute */
  .stage :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }

  .stage :global(canvas:active) {
    cursor: grabbing;
  }

  .hint {
    position: absolute;
    left: 20px;
    bottom: 16px;
    font: 12px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    pointer-events: none;
  }

  .close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-3);
    cursor: pointer;
  }

  .close:hover {
    background: color-mix(in srgb, var(--ink) 7%, transparent);
    color: var(--ink);
  }

  .close svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  aside {
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 28px 26px 24px;
    border-left: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 92%, white);
  }

  .eyebrow {
    margin: 0 0 20px;
    font: 12px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .stages {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stages li {
    position: relative;
    opacity: 0.55;
    transition: opacity 0.3s;
  }

  .stages li:hover {
    opacity: 0.85;
  }

  .stages li.on {
    opacity: 1;
  }

  /* dashed thread between stages */
  .stages li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 21.5px;
    top: 50px;
    bottom: -18px;
    border-left: 1.5px dashed color-mix(in srgb, var(--ink-3) 55%, transparent);
  }

  .stages button {
    display: grid;
    grid-template-columns: 44px 1fr;
    column-gap: 16px;
    align-items: start;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .stages button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .icon svg {
    width: 33px;
    height: 33px;
  }

  .on .icon {
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .words {
    display: grid;
    gap: 4px;
    padding-top: 1px;
  }

  .name {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--ink);
  }

  .on .name {
    color: var(--accent);
  }

  .n {
    margin-right: 6px;
    font: 11.5px var(--mono);
    color: var(--ink-3);
  }

  .text {
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-2);
  }

  /* While the tour plays, the current stage fills a thin bar. */
  .bar {
    display: block;
    height: 2px;
    margin-top: 4px;
    border-radius: 1px;
    background: var(--rule);
    overflow: hidden;
    visibility: hidden;
  }

  .bar::before {
    content: '';
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }

  .playing .on .bar {
    visibility: visible;
  }

  .playing .on .bar::before {
    animation: fill var(--dwell) linear forwards;
  }

  @keyframes fill {
    to {
      transform: scaleX(1);
    }
  }

  /* Narrow screens: the scene on top, the stages as a row to swipe through. */
  @media (max-width: 760px) {
    .scene-box {
      padding: 12px;
    }

    .panel {
      grid-template-columns: minmax(0, 1fr);
      width: calc(100vw - 24px);
      height: auto;
    }

    .stage {
      aspect-ratio: 4 / 5;
      max-height: calc(100dvh - 280px);
    }

    aside {
      padding: 16px 0 18px;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }

    .eyebrow {
      margin: 0 16px 12px;
    }

    .stages {
      flex-direction: row;
      gap: 10px;
      overflow-x: auto;
      padding: 0 16px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .stages li {
      flex: 0 0 210px;
      scroll-snap-align: start;
    }

    .stages li:not(:last-child)::after {
      display: none;
    }

    .stages button {
      grid-template-columns: 36px 1fr;
      column-gap: 10px;
    }

    .icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
    }

    .icon svg {
      width: 27px;
      height: 27px;
    }

    .name {
      font-size: 14.5px;
    }

    .text {
      font-size: 13px;
    }

    .hint {
      left: 14px;
      bottom: 12px;
    }
  }
</style>
